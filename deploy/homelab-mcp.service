[Unit]
Description=homelab-mcp (Proxmox / Home Assistant / ESPHome MCP server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homelab-mcp
Group=homelab-mcp
# Secrets referenced as ${VAR} in homelab.yaml come from here (chmod 600):
EnvironmentFile=-/etc/homelab-mcp/homelab-mcp.env
Environment=HOMELAB_MCP_CONFIG=/etc/homelab-mcp/homelab.yaml
ExecStart=/opt/homelab-mcp/.venv/bin/homelab-mcp
Restart=on-failure
RestartSec=3

# Hardening (the process still needs outbound network + its SSH key).
# NoNewPrivileges= also disables file capabilities, so /usr/bin/ping's
# cap_net_raw+ep is ignored under this unit. net_ping relies instead on the
# unprivileged ICMP datagram socket, which the kernel allows for groups listed in
# net.ipv4.ping_group_range; deploy/install.sh adds the homelab-mcp group there
# (/etc/sysctl.d/60-homelab-mcp.conf). That grants this process no capability
# at all. If that sysctl cannot be set in your container, the fallback is to
# hand the unit CAP_NET_RAW (ambient caps survive NoNewPrivileges=):
#AmbientCapabilities=CAP_NET_RAW
#CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/homelab-mcp
ReadOnlyPaths=/etc/homelab-mcp
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
